# Environment variables consumed by config/gaith-chatbot.php (Laravel bridge only).
# Copy this file to .env in your Laravel application and fill in real values.
# Never commit a real .env file or a real API key.

# Which connection under `connections` is resolved by default when no name is given.
GAITH_CHATBOT_CONNECTION=default

# GAITH backend host (no path, no trailing slash) — e.g. one of:
#   https://gaith-backend-dev.osos.om
#   https://gaith-backend-qa.osos.om
#   https://gaith-backend-uat.osos.om
GAITH_CHATBOT_BASE_URL=

# The chatbot's UUID.
GAITH_CHATBOT_ID=

# Chatbot-scoped API key (must carry the chatbot:chat permission).
# Server-side secret only — never expose this to a browser or mobile client.
GAITH_CHATBOT_API_KEY=

# Timeout (seconds) for the buffered JSON transport (meta/conversations/attachments).
# Does not apply to the streaming /chat call, which is intentionally unbounded.
GAITH_CHATBOT_HTTP_TIMEOUT=30

# --- <gaith-chat> widget routes (off until you set middleware in config/gaith-chatbot.php) ---
GAITH_CHAT_WIDGET_ENABLED=false

# Routes become {prefix}/stream and {prefix}/conversations/{id}/messages.
GAITH_CHAT_WIDGET_PREFIX=api/gaith

# Prepended to your user id to form the GAITH external_user_id, e.g. erp-user-, qhse-user-.
GAITH_CHAT_WIDGET_USER_PREFIX=user-

# Connection under `connections` the widget uses; empty = the default connection.
GAITH_CHAT_WIDGET_CONNECTION=

# Widget colours for this product (any CSS colour: #hex, rgb(), hsl() or a name).
# Primary = launcher, header, user bubbles, send button; text = what is drawn on top of it.
GAITH_CHAT_WIDGET_PRIMARY_COLOR=#1f6feb
GAITH_CHAT_WIDGET_TEXT_COLOR=#ffffff

# This product's data protection policy, linked from the lock in the chat header (https:// URL or /path).
GAITH_CHAT_WIDGET_PRIVACY_URL=

# Mic button (dictation). The browser's speech service (Google/Microsoft/Apple) hears the audio; false turns it off.
GAITH_CHAT_WIDGET_VOICE=true

# Let users attach files to messages (uploaded to GAITH). Needs PHP upload_max_filesize/post_max_size >= 20M.
GAITH_CHAT_WIDGET_ATTACHMENTS=true
# Which file types users may attach. Only list what GAITH accepts for chat uploads (today pdf, docx, png, jpg).
# The SDK also supports: doc, xls, xlsx, csv, md, txt, webp, bmp, tif, tiff
GAITH_CHAT_WIDGET_ATTACHMENT_TYPES=pdf,docx,png,jpg,jpeg

# Extra origins markdown images in replies may load from (your own app's origin is always allowed),
# comma-separated, e.g. an MCP server that returns image links. Others render as plain links.
GAITH_CHAT_WIDGET_IMAGE_ORIGINS=
