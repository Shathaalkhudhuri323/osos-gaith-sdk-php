{
    "name": "osos/gaith-sdk-php",
    "description": "PHP client SDK for the GAITH chatbot public HTTP/SSE API.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^7.4 || ^8.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "php-http/multipart-stream-builder": "^1.3",
        "ramsey/uuid": "^4.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "illuminate/support": "^8.0",
        "illuminate/contracts": "^8.0",
        "illuminate/container": "^8.0",
        "illuminate/config": "^8.0",
        "vlucas/phpdotenv": "^5.0"
    },
    "suggest": {
        "illuminate/support": "Required to use the Laravel service provider (Osos\\Gaith\\Sdk\\Laravel\\GaithChatbotServiceProvider)."
    },
    "autoload": {
        "psr-4": {
            "Osos\\Gaith\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Osos\\Gaith\\Sdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Osos\\Gaith\\Sdk\\Laravel\\GaithChatbotServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
